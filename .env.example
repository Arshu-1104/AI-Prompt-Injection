# Set strong, unique values before any deployment.
POSTGRES_PASSWORD=
ADMIN_SECRET_KEY=
NEXTAUTH_SECRET=
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('change-me', 12))"
ADMIN_PASSWORD_HASH=
# Optional external service key. The dashboard uses ADMIN_SECRET_KEY internally.
PROMPTGUARD_API_KEY=
# Comma-separated browser origins allowed to call the API directly (default: none).
CORS_ALLOW_ORIGINS=

# Optional heavy models (bert = DistilBERT, guard = ModernBERT). Needs the heavy image
# (INSTALL_HEAVY=1) and roughly 1.5-3 GB RAM. Model ids are Hugging Face Hub repos
# (or local paths); without them the API falls back to models/bert_model, models/guard_model.
INSTALL_HEAVY=0
ENABLE_HEAVY_MODELS=false
BERT_MODEL_ID=
GUARD_MODEL_ID=
# Read token for private Hub repos (write token only needed for --push-to-hub).
HF_TOKEN=
# Use 1 with heavy models: each uvicorn worker loads its own copy.
WEB_CONCURRENCY=2
