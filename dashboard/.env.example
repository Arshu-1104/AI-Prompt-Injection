# Server-only backend URL. Use the Docker service hostname in Compose.
API_URL=http://localhost:8000
ADMIN_EMAIL=admin@promptguard.local
# Generate with: node -e "console.log(require('bcryptjs').hashSync('change-me', 12))"
ADMIN_PASSWORD_HASH=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Optional external API key. The dashboard proxy uses ADMIN_SECRET_KEY internally.
PROMPTGUARD_API_KEY=
# Must exactly match the backend's ADMIN_SECRET_KEY.
ADMIN_SECRET_KEY=